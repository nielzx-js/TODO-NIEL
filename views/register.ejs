
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <title>Criar conta</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #0F1220;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 25px;
        }

        form {
            background: #1A1F33;
            border: 1px solid #2B3250;
            border-radius: 18px;
            width: 100%;
            max-width: 420px;
            padding: 35px;

            display: flex;
            flex-direction: column;
            gap: 12px;

            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
        }

        .titulo {
            text-align: center;
            margin-bottom: 15px;
        }

        .titulo h1 {
            color: #E8EAF6;
            font-size: 26px;
            font-weight: 600;
        }

        .titulo p {
            color: #9AA3C7;
            font-size: 13px;
            margin-top: 6px;
        }

        label {
            color: #E8EAF6;
            font-size: 13px;
            font-weight: 500;
        }

        input {
            width: 100%;
            padding: 12px 14px;
            background: #0F1220;
            border: 1px solid #2B3250;
            border-radius: 9px;
            color: #E8EAF6;
            font-size: 14px;
            outline: none;
            transition: 0.3s;
        }

        input::placeholder {
            color: #69718F;
        }

        input:focus {
            border-color: #6C5CE7;
            box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.15);
        }

        button {
            margin-top: 12px;
            padding: 13px;
            border: none;
            border-radius: 9px;
            background: #6C5CE7;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background: #5848D6;
            transform: translateY(-2px);
            box-shadow: 0 5px 18px rgba(108, 92, 231, 0.3);
        }

        button:active {
            transform: translateY(0);
        }

        .login {
            text-align: center;
            color: #9AA3C7;
            font-size: 12px;
            margin-top: 8px;
        }

        .login a {
            color: #00B8D9;
            text-decoration: none;
            font-weight: 600;
        }

        .login a:hover {
            text-decoration: underline;
        }

        @media (max-width: 450px) {
            form {
                padding: 28px 22px;
            }
        }
    </style>
</head>

<body>

    <form action="/register" method="POST">

        <div class="titulo">
            <h1>Criar conta</h1>
            <p>Preencha os dados para começar.</p>
        </div>

        <label for="nome">Nome completo</label>
        <input
            type="text"
            id="nome"
            name="nome"
            placeholder="Digite seu nome"
            required
        >

        <label for="email">Email</label>
        <input
            type="email"
            id="email"
            name="email"
            placeholder="seuemail@exemplo.com"
            required
        >

        <label for="senha">Senha</label>
        <input
            type="password"
            id="senha"
            name="senha"
            placeholder="Crie uma senha"
            required
        >

        <label for="confirmarSenha">Confirmar senha</label>
        <input
            type="password"
            id="confirmarSenha"
            name="confirmarSenha"
            placeholder="Repita sua senha"
            required
        >
        

        <button type="submit">Criar minha conta</button>

        <p class="login">
            Já possui uma conta? <a href="/">Entrar</a>
        </p>

    </form>

</body>
</html>
