<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page-shell">
        <%- include('partials/menu.ejs', { activeRoute: '/inicio' }) %>

        <main class="main-content">
            <div class="content-panel">
                <h1 class="section-title">Atividades próximas da entrega</h1>

                <div class="task-grid">
                    <% if (tarefas.length === 0) { %>
                        <div class="task-card empty-card">
                            <p>Você ainda não tem tarefas cadastradas.</p>
                        </div>
                    <% } %>

                    <% tarefas.forEach(tarefa => { %>
                        <article class="task-card">
                            <div class="task-card-header">
                                <h3><%= tarefa.titulo %></h3>
                                <% const status = tarefa.status || 'pendente'; %>
                                <span class="task-status <%= status %>"><%= status %></span>
                            </div>

                            <p><%= tarefa.descricao %></p>
                            <p><%= tarefa.data_limite%></p>
                            <div class="task-card-actions">
                                <a href="/edit/<%= tarefa.id %>" class="btn btn-primary">Editar</a>
                                <form method="POST" action="/excluir/<%= tarefa.id %>">
                                    <button type="submit" class="btn btn-danger">Excluir</button>
                                </form>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </div>
        </main>
    </div>
</body>
</html>