<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
    <title>Redefinir senha</title>
</head>
<body class="auth-page">
    <form class="auth-form" method="POST" action="/senha" id="formSenha">
        <div class="titulo">
            <h1>Redefinir senha</h1>
            <p>Crie uma nova senha para sua conta.</p>
        </div>

        <label for="senha1">Nova senha</label>
        <input type="password" name="senha1" id="senha1" minlength="5" required>

        <label for="senha2">Confirme a nova senha</label>
        <input type="password" name="senha2" id="senha2" minlength="5" required>

        <button type="submit">Salvar senha</button>
    </form>

    <script>
        const form = document.getElementById('formSenha');

        form.addEventListener('submit', (event) => {
            const senha1 = document.getElementById('senha1').value;
            const senha2 = document.getElementById('senha2').value;

            if (senha1.length < 5) {
                event.preventDefault();
                alert('Insira uma senha de pelo menos 5 caracteres.');
                return;
            }

            if (senha1 !== senha2) {
                event.preventDefault();
                alert('As senhas não são iguais.');
            }
        });
    </script>
    <%- include('partials/footer') %>
</body>
</html>
