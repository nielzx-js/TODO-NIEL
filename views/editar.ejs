<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar tarefa</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#6366f1">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
</head>
<body>
    <div class="page-shell">
        <%- include('partials/menu.ejs', { activeRoute: '/tarefas' }) %>

        <main class="main-content">
            <div class="content-panel">
                <form class="task-form" action="/editar/<%= tarefa.id %>" method="POST">
                    <h1>Editar tarefa</h1>

                    <div class="form-field">
                        <label for="titulo">Título</label>
                        <input type="text" id="titulo" name="titulo" value="<%= tarefa.titulo %>" required>
                    </div>

                    <div class="form-field">
                        <label for="descricao">Descrição</label>
                        <textarea id="descricao" name="descricao" required><%= tarefa.descricao %></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </form>
            </div>
        </main>
    </div>
    <%- include('partials/footer') %>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
        }
    </script>
</body>
</html>