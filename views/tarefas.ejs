<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas tarefas</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#6366f1">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
</head>
<body>
    <div class="page-shell">
        <%- include('partials/menu.ejs', { activeRoute: '/tarefas' }) %>

        <main class="main-content">
            <div class="content-panel">
                <h1 class="section-title">Minhas tarefas</h1>

                <div class="task-grid">
                    <% if (tarefas.length === 0) { %>
                        <div class="task-card empty-card">
                            <p>Nenhuma tarefa cadastrada ainda.</p>
                        </div>
                    <% } %>

                    <% tarefas.forEach(tarefa => { %>
                        <article class="task-card">
                            <div class="task-card-header">
                                <h3><%= tarefa.titulo %></h3>
                                <% const status = tarefa.status || 'pendente'; %>
                                <span class="task-status <%= status %>"><%= status %></span>
                            </div>

                            <p><%= tarefa.descricao %></p>

                            <div class="task-card-actions">
                                <a href="/edit/<%= tarefa.id %>" class="btn btn-primary">Editar</a>
                                <form method="POST" action="/excluir/<%= tarefa.id %>">
                                    <button type="submit" class="btn btn-danger">Excluir</button>
                                </form>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </div>
        </main>
    </div>
    <%- include('partials/footer') %>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
        }
    </script>
</body>
</html>